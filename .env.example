# Copy to .env.local and fill in. Never commit real values.

# --- Public site (safe in the browser bundle) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-05-15

# Server-only. Only needed if your dataset is private (a Viewer token).
SANITY_API_READ_TOKEN=

# --- Local tooling only: never add these to Vercel ---
# Robot token with the Editor role (sanity.io/manage → API → Tokens). Used by
# the seed script, the draft-card agent, the workflow worker and the local
# /api/agent/draft-card endpoint. Editor role means it can draft but cannot
# fire the workflow's verify / publish / reject actions (those need administrator).
SANITY_API_WRITE_TOKEN=

# Optional: raises the NVD rate limit (https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=

# Origins allowed to call /api/agent/draft-card (Card Forge). Defaults to http://localhost:3333.
CARD_FORGE_ORIGINS=
