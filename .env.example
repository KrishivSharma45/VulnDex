# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-05-15

# Server-only (no NEXT_PUBLIC_ prefix). Viewer token from sanity.io/manage → API → Tokens.
SANITY_API_READ_TOKEN=

# Seed script only (npm run seed). Editor token; keep it local, don't add it to Vercel.
SANITY_API_WRITE_TOKEN=
# Optional: raises NVD rate limit (https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=
